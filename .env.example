# Neon Postgres pooled connection string (from neon.tech dashboard)
DATABASE_URL="postgresql://user:password@xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Long random secret for admin session signing
AUTH_SECRET="change-me-to-a-long-random-string"
# Set automatically by Vercel when a Blob store is connected (leave empty locally)
BLOB_READ_WRITE_TOKEN=""
